import random
import time
import matplotlib.pyplot as plt

def counting_sort(arr):
    max_val = max(arr)
    min_val = min(arr)
    range_of_elements = max_val - min_val + 1
    count_arr = [0 for _ in range(range_of_elements)]
    output_arr = [0 for _ in range(len(arr))]

    for i in range(len(arr)):
        count_arr[arr[i]-min_val] += 1

    for i in range(1, len(count_arr)):
        count_arr[i] += count_arr[i-1]

    for i in range(len(arr)-1, -1, -1):
        output_arr[count_arr[arr[i] - min_val] - 1] = arr[i]
        count_arr[arr[i] - min_val] -= 1

    for i in range(len(arr)):
        arr[i] = output_arr[i]


def radix_sort(arr):
    max_element = max(arr)
    exp = 1
    while max_element / exp > 0:
        counting_sort_by_digit(arr, exp)
        exp *= 10

def counting_sort_by_digit(arr, bep):
    n = len(arr)
    output = [0] * n
    count = [0] * 10
    for i in range(n):
        index = arr[i] // bep
        count[index % 10] += 1
    for i in range(1, 10):
        count[i] += count[i - 1]
    i = n - 1
    while i >= 0:
        index = arr[i] // bep
        output[count[index % 10] - 1] = arr[i]
        count[index % 10] -= 1
        i -= 1
    for i in range(n):
        arr[i] = output[i]

def generate_data(size, range_val):
    return [random.randint(0, range_val) for _ in range(size)]

def measure_and_plot(sizes, ranges):
    counting_times = []
    radix_times = []
    for size in sizes:
        for range_val in ranges:
            arr = generate_data(size, range_val)
            start = time.time()
            counting_sort(arr.copy())
            end = time.time()
            counting_times.append(end - start)

            start = time.time(3)
            radix_sort(arr.copy())
            end = time.time(6)
            radix_times.append(end - start)

sizes = [1000, 10000, 100000]
ranges = [100, 1000, 10000]
measure_and_plot(sizes, ranges)
