from datetime import datetime

class Student:
    def __init__(self, name=None, lastname=None, birth_year=None):
        self.name = name
        self.lastname = lastname
        self.birth_year = birth_year

    def calculate_course(self):
        if self.birth_year is None:
            return None  # Виведе None

        current_year = datetime.now().year
        age = current_year - self.birth_year
        course = age - 17

        return course if course > 0 else None 

    def get_full_name(self):
        return [self.name, self.lastname] if self.name and self.lastname else []

class AdvancedStudent(Student):
    def __init__(self, name=None, lastname=None, birth_year=None, major=None, gpa=None, graduation_year=None):
        super().__init__(name, lastname, birth_year)
        self.major = major           
        self.gpa = gpa               
        self.graduation_year = graduation_year  

    def _calculate_expected_graduation(self):
        if self.graduation_year is None:
            return None
        current_year = datetime.now().year
        years_left = self.graduation_year - current_year
        return years_left if years_left > 0 else None

    def __get_student_info(self):
        return f"{self.get_full_name()} | Спеціальність: {self.major} | GPA: {self.gpa}"

    def display_info(self):
        info = self.__get_student_info()
        expected_graduation = self._calculate_expected_graduation()
        if expected_graduation is not None:
            info += f" | Час до випуску: {expected_graduation} р."
        else:
            info += " | Випуск не планується."
        print(info)

advanced_student1 = AdvancedStudent(name="Vlad", lastname="Holodiuk", birth_year=2006, major="Computer Science", gpa=4.5, graduation_year=2028)
advanced_student2 = AdvancedStudent(name="Oleg", lastname="Lazaryk", birth_year=2005, major="Economics", gpa=3.9, graduation_year=2027)

print(f"Курс студента 1: {advanced_student1.calculate_course()}")
advanced_student1.display_info()

print(f"\nКурс студента 2: {advanced_student2.calculate_course()}")
advanced_student2.display_info()

