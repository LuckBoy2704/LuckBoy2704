
import telebot
from telebot import types

bot = telebot.TeleBot('7666894807:AAHPmYTRtS0OOwAv1Begxw38oEYIVu2GoYI')


def  men_sett (message, text, buttons):
    keyboard = telebot.types.ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
    for item in buttons:
        button = telebot.types.KeyboardButton(item)
        keyboard.add(button)
    for t in text:
        bot.send_message(message.chat.id, t, reply_markup=keyboard)


@bot.message_handler(commands=['start'])
def start(message):
    men_sett(message=message,text=['Вас вітає бот по продажі системних блоків ',
             'Чим можу допомогти?'],
             buttons=['Перейти до меню'])

def exit_program(message):
    bot.send_message(message.chat.id, 'Гаразд')
    bot.stop_polling()


