import telebot
from telebot import types

bot = telebot.TeleBot('7666894807:AAHPmYTRtS0OOwAv1Begxw38oEYIVu2GoYI')

def reading_txt_file(name):
    with open('text', 'r', encoding='utf8') as file:
        while True:
            good = file.readline()
            if not good:
                return None
            model, url = good.strip().split(',')
            if model == name:
                return url

def send_link(message):
    url = reading_txt_file(message.text)
    if url:
        bot.send_message(message.chat.id, f"Посилання на {message.text}: {url}")
    else:
        bot.send_message(message.chat.id, "Посилання не знайдено.")
    men_sett(message=message, text=['Непоганий варіант'], buttons=['Назад'])

def men_sett(message, text, buttons):
    keyboard = types.ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
    for item in buttons:
        button = types.KeyboardButton(item)
        keyboard.add(button)
    for top in text:
        bot.send_message(message.chat.id, top, reply_markup=keyboard)

@bot.message_handler(commands=['start'])
def start(message):
    men_sett(message=message, text=['Вас вітає бот по продажі системних блоків',
                                    'Чим можу допомогти?'], buttons=['Перейти до меню'])

def exit_program(message):
    bot.send_message(message.chat.id, 'Добре')
    bot.stop_polling()

