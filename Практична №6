import telebot
from telebot import types

bot = telebot.TeleBot('7666894807:AAHPmYTRtS0OOwAv1Begxw38oEYIVu2GoYI')

def reading_txt_file(name):
    with open('text', 'r', encoding='utf8') as file:
        for good in file:
            item_name, url = good.strip().split(',')
            if item_name == name:
                return url
    return None

def link(message):
    url = reading_txt_file(message.text)
    if url:
        bot.send_message(message.chat.id, text=[f'Посилання на {message.text}: {url}'])
    men_sett(message, text=['Непоганий варіант'], buttons=['Назад'])

def men_sett(message, text, buttons):
    keyboard = types.ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
    for item in buttons:
        button = types.KeyboardButton(item)
        keyboard.add(button)
    for t in text:
        bot.send_message(message.chat.id,t,reply_markup=keyboard)

@bot.message_handler(commands=['start'])
def start(message):
    men_sett(message=message, text=['Вас вітає бот по продажі системних блоків','Чим можу допомогти?'],
             buttons=['Ознайомча_інформація','Характеристика','Перейти до меню'])
@bot.message_handler(commands=['exit'])
def exit_mess(message):
    bot.send_message(message.chat.id,'Добре')
    bot.stop_polling()
@bot.message_handler(content_types=['text'])
